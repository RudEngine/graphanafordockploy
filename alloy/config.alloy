// Читает access.log Traefik (Dokploy пишет его в JSON при включённых Requests)
// и отправляет в Loki.
//
// Лейблы (индексируются): job, host, status.
// Всё остальное (путь, IP, метод, длительность, User-Agent) остаётся в JSON-строке
// и достаётся в Grafana через `| json` — так не раздуваем кардинальность.

local.file_match "traefik_access" {
	path_targets = [{
		"__path__" = "/var/log/traefik/access.log",
		"job"      = "traefik",
	}]
	sync_period = "10s"
}

loki.source.file "traefik_access" {
	targets    = local.file_match.traefik_access.targets
	forward_to = [loki.process.traefik.receiver]
}

loki.process "traefik" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			ts     = "StartUTC",
			host   = "RequestHost",
			router = "RouterName",
			status = "DownstreamStatus",
		}
	}

	// Время запроса берём из самого лога, а не из момента чтения.
	// Заодно это даёт дедупликацию в Loki, когда Dokploy обрезает файл и Alloy перечитывает хвост.
	stage.timestamp {
		source = "ts"
		format = "RFC3339Nano"
	}

	// Сканеры шлют мусор в Host. Если запрос не попал ни в один роутер — не плодим лейблы,
	// кладём всё в host="unrouted" (оригинальный Host остаётся в строке лога).
	stage.template {
		source   = "host"
		template = "{{ if .router }}{{ ToLower .host }}{{ else }}unrouted{{ end }}"
	}

	stage.drop {
		source              = "host"
		value               = sys.env("GRAFANA_HOST")
		drop_counter_reason = "grafana_self"
	}

	stage.labels {
		values = {
			host   = "",
			status = "",
		}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// ---------------------------------------------------------------------------
// CPU / RAM / сеть / диск по контейнерам: встроенный cAdvisor → Prometheus.
//
// Лейбл container — имя для графиков: у Swarm-сервисов Dokploy (app.1.<task id>)
// отрезаем хвост задачи, чтобы реплики и редеплои сливались в одну линию.
// Общая загрузка хоста — из prometheus.exporter.unix (/proc/stat, /proc/meminfo).

prometheus.exporter.cadvisor "docker" {
	docker_host            = "unix:///var/run/docker.sock"
	docker_only            = true
	store_container_labels = false
	enabled_metrics        = ["cpu", "memory", "network", "diskIO"]
	storage_duration       = "2m"
}

prometheus.scrape "cadvisor" {
	targets         = prometheus.exporter.cadvisor.docker.targets
	scrape_interval = "15s"
	forward_to      = [prometheus.relabel.cadvisor.receiver]
}

prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "meminfo"]
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "15s"
	forward_to      = [prometheus.relabel.cadvisor.receiver]
}

prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.default.receiver]

	// Только то, что есть на дашборде — остальное cAdvisor плодит сотнями рядов
	rule {
		source_labels = ["__name__"]
		regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_spec_memory_limit_bytes|container_network_(receive|transmit)_bytes_total|container_fs_(reads|writes)_bytes_total|node_cpu_seconds_total|node_memory_(MemTotal|MemAvailable)_bytes"
		action        = "keep"
	}

	// instance по умолчанию — hostname контейнера Alloy, он меняется при каждом редеплое,
	// и минут 5 старые ряды суммировались бы с новыми
	rule {
		target_label = "instance"
		replacement  = "dokploy"
	}

	rule {
		source_labels = ["name"]
		regex         = "(.+?)(\\.\\d+\\.[a-z0-9]{25})?"
		target_label  = "container"
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}
